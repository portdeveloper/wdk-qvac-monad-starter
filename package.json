{
  "name": "wdk-qvac-monad-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Hackathon starter: Tether WDK self-custodial wallet + QVAC local AI agent on Monad",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node --env-file-if-exists=.env scripts/setup.js",
    "balance": "node --env-file=.env scripts/balance.js",
    "send": "node --env-file=.env scripts/send.js",
    "mint": "node --env-file=.env scripts/mint.js",
    "agent": "node --env-file=.env src/agent.js",
    "test:burst": "node --env-file=.env scripts/burst.js"
  },
  "license": "MIT",
  "dependencies": {
    "@qvac/sdk": "0.23.0",
    "@tetherto/wdk": "1.0.0-beta.22",
    "@tetherto/wdk-wallet-evm": "1.0.0-beta.25",
    "ethers": "6.17.0",
    "zod": "4.6.7"
  }
}
